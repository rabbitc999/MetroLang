# 冒烟样例（ASCII 站名）：给 check.sh 用 —— 中文站名在 Windows 控制台按本地
# 代码页（CP936）传 argv，会被解释器按 GBK 收到，route 查站名必然失败；换成
# ASCII 站名，check.sh 在任何平台的任何代码页下都能稳定跑通。
PROGRAM_DEFINE
    KEY_CITY 'SmokeCity'
    VERSION 'V1.0'
    AUTHOR 'MetroLang'
END_DEFINE

STATION_DEFINE
    NODE 'S1' COORD 121.00, 31.00 CITY 'SmokeCity'
    NODE 'S2' COORD 121.02, 31.00 CITY 'SmokeCity'
    NODE 'S3' COORD 121.04, 31.00 CITY 'SmokeCity'
    NODE 'S4' COORD 121.04, 31.02 CITY 'SmokeCity'
    NODE 'S5' COORD 121.04, 31.04 CITY 'SmokeCity'
END_DEFINE

LINE_DEFINE L1
    NAME 'Line 1'
    COLOR '#E61F26'
    CITY 'SmokeCity'
    MAXSPEED 80
    DIRECTION_DEFINE L1_0
        STATIONS ['S1', 'S2', 'S3']
        DISTANCE AUTO
        DWELL_TIME 30
    END_DEFINE
    DIRECTION_DEFINE L1_1 REV L1_0
END_DEFINE

LINE_DEFINE L2
    NAME 'Line 2'
    COLOR '#1E88E5'
    CITY 'SmokeCity'
    MAXSPEED 80
    DIRECTION_DEFINE L2_0
        STATIONS ['S3', 'S4', 'S5']
        DISTANCE AUTO
    END_DEFINE
END_DEFINE

TRANSFER SAME 'S3' L1 L2
