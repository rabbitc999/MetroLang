# MetroLang 样例：两条线路、六座车站、一次换乘
PROGRAM_DEFINE
    KEY_CITY '示例市'
    OTHER_CITY ['示例北']
    VERSION 'V1.0'
    AUTHOR 'MetroLang'
END_DEFINE

OPERATION_DEFINE
    TRANSFER_TIME 180
    DWELL_TIME 30
    ENTRY_TIME 120
END_DEFINE

TRANSFER_TYPE SAME '同站换乘'
    TIME 120
    STATUS operating
END_DEFINE

STATION_DEFINE
    NODE '甲站' COORD 121.00, 31.00 CITY '示例市'
    NODE '乙站' COORD 121.02, 31.00 CITY '示例市'
    NODE '丙站' COORD 121.04, 31.00 CITY '示例市'
    NODE '丁站' COORD 121.06, 31.00 CITY '示例市'
    NODE '戊站' COORD 121.06, 31.02 CITY '示例市'
    NODE '己站' COORD 121.06, 31.04 CITY '示例市'
END_DEFINE

# 无障碍设施：JSON v2 把这一块的数据内联进对应站点的 `accessibility`
FACILITY_DEFINE
    TOILET '丁站' POSITION PAID_AREA ACCESSIBLE GENDER MIXED
    ACCESSIBLE_TOILET '丁站' POSITION PAID_AREA GENDER MIXED
    ELEVATOR '丁站' LOCATION 'A口出口旁' ACCESSIBLE
    WIDE_GATE '丁站' QUANTITY 2
    ESCALATOR '丁站' QUANTITY 4 DIRECTION both
    TACTILE_PAVING '丁站' STATUS available
    ELEVATOR '甲站' LOCATION 'B口' ACCESSIBLE
    TACTILE_PAVING '甲站' STATUS partial
END_DEFINE

LINE_DEFINE L1
    NAME '1号线'
    COLOR '#E61F26'
    CITY '示例市'
    MAXSPEED 80
    OPEN_YEAR 2010
    DIRECTION_DEFINE L1_0
        STATIONS ['甲站', '乙站', '丙站', '丁站']
        DISTANCE AUTO
        DWELL_TIME 30
    END_DEFINE
    DIRECTION_DEFINE L1_1 REV L1_0
END_DEFINE

LINE_DEFINE L2
    NAME '2号线'
    COLOR '#1E88E5'
    CITY '示例市'
    MAXSPEED 80
    DIRECTION_DEFINE L2_0
        STATIONS ['丁站', '戊站', '己站']
        DISTANCE AUTO
    END_DEFINE
END_DEFINE

TRANSFER SAME '丁站' L1 L2

PRICE_DEFINE
    DEFAULT_FARE 2
    SEGMENT 0 6 2
    SEGMENT 6 12 3
    LINEAR_EXTENSION THRESHOLD 12 BASE_FARE 3 RATE_PER_KM 0.3
END_DEFINE
