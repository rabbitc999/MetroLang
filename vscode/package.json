{
  "name": "metro-lang-editor",
  "displayName": "MetroLang",
  "description": "MetroLang（.metro / .m）语言支持：语法高亮、块折叠、编译器内嵌 LSP 诊断与地图预览。",
  "version": "1.0.1",
  "publisher": "rabbitc999",
  "author": {
    "name": "小兔糖糖OvO",
    "email": "rabbitc999@outlook.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@vscode/vsce": "^3.2.1"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "metro",
    "metrolang",
    "metro-lang",
    "parseengine"
  ],
  "main": "./extension.js",
  "scripts": {
    "embed": "node tools/embed-compiler.js",
    "check": "node tools/check-manifest.js",
    "test": "node test/smoke.js && node test/lsp.js",
    "vscode:prepublish": "node tools/embed-compiler.js",
    "package": "node tools/package.js"
  },
  "icon": "icon.png",
  "activationEvents": [
    "onLanguage:metro-lang",
    "onCommand:metro.openDoc",
    "onCommand:metro.previewMap"
  ],
  "contributes": {
    "languages": [
      {
        "id": "metro-lang",
        "aliases": [
          "MetroLang",
          "metro"
        ],
        "extensions": [
          ".metro",
          ".m"
        ],
        "configuration": "./metro-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "metro-lang",
        "scopeName": "source.metro-lang",
        "path": "./syntaxes/metro.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[metro-lang]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.suggest.showWords": false
      }
    },
    "commands": [
      {
        "command": "metro.openDoc",
        "title": "Metro: 打开 MetroLang 语言参考"
      },
      {
        "command": "metro.previewMap",
        "title": "Metro: 预览地图（编译当前文档）",
        "icon": "$(map)"
      },
      {
        "command": "metro.previewMapFile",
        "title": "MetroLang: 从文件预览地图"
      },
      {
        "command": "metro.restartServer",
        "title": "Metro: 重启语言服务器"
      },
      {
        "command": "metro.previewData",
        "title": "Metro: 数据预览（统计摘要）",
        "icon": "$(table)"
      },
      {
        "command": "metro.queryRoute",
        "title": "Metro: 查询路线（起终点 → 耗时票价）",
        "icon": "$(git-compare)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "metro.previewMap",
          "when": "resourceLangId == metro-lang",
          "group": "navigation"
        },
        {
          "command": "metro.previewData",
          "when": "resourceLangId == metro-lang",
          "group": "navigation"
        },
        {
          "command": "metro.queryRoute",
          "when": "resourceLangId == metro-lang",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "MetroLang",
      "properties": {
        "metro-lang.serverPath": {
          "type": "string",
          "default": "",
          "description": "metro-lang 可执行文件路径；留空则按 工作区 build/metro-lang/ → 仓库 build/metro-lang/ 的顺序自动找。"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rabbitc999/metro-lang.git"
  }
}
