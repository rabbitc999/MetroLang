special_define_block := SPECIAL_DEFINE special_open special_members END_DEFINE NL { mb_end_block(); $$ = 0; }
special_open := args NL                    { mb_begin(MB_SPECIAL_DEFINE); $$ = 0; }
special_members := special_members special_member { $$ = 0; }
special_members := %empty                  { $$ = 0; }
special_members := special_members NL   { $$ = 0; }
special_member := any_head args NL         { mb_line($1); $$ = 0; }
any_head := top_kw { $$ = $1; } | member_kw { $$ = $1; } | VARIABLE { $$ = $1; };

/* ============================ 参数与列表 ============================ */
args := args arg                           { $$ = 0; }
args := %empty                             { $$ = 0; }
arg := STRING                              { mb_arg($1); $$ = 0; }
arg := NUMBER                              { mb_arg($1); $$ = 0; }
arg := VARIABLE                            { mb_arg($1); $$ = 0; }
arg := kw_arg                              { mb_arg($1); $$ = 0; }
/* 列表直接由 list 产生式负责：不要再写 `arg := LBRACK list RBRACK`。
 * 那个写法会给 `list` 造出一个「只有 [] 前缀」的中间状态，在超长文法里
 * 它的闭包会漏掉 list_item 的全部移进动作（`[1]` 被误判成语法错误）。 */
arg := list                                { $$ = 0; }
arg := COMMA                               { $$ = 0; }
arg := COLON                               { $$ = 0; }
arg := LPAREN                              { $$ = 0; }
arg := RPAREN                              { $$ = 0; }
arg := OP                                  { $$ = 0; }

/* 列表用**右递归**：`[` 之后先 Shift 第一项，遇到 `]` 才归约空尾。
 * 不要把这里改成“左递归 + %empty”的写法：那一形在超长文法里会漏算
 * 空规则的 lookahead，表现为 `[1]` / `['a']` 被误判成语法错误。 */
list := LBRACK list_body RBRACK            { $$ = 0; }
list_body := list_item list_body           { $$ = 0; }
list_body := %empty                        { $$ = 0; }
list_item := STRING                        { mb_arg($1); $$ = 0; }
list_item := NUMBER                        { mb_arg($1); $$ = 0; }
list_item := VARIABLE                      { mb_arg($1); $$ = 0; }
list_item := kw_arg                        { mb_arg($1); $$ = 0; }
list_item := COMMA                         { $$ = 0; }
list_item := NL                            { $$ = 0; }
list_item := list                          { $$ = 0; }

