operator_field := DESCRIPTION { $$ = $1; } | LOGO { $$ = $1; } | LINES { $$ = $1; };

background_block := BACKGROUND_DEFINE background_open background_members END_DEFINE NL { mb_end_block(); $$ = 0; }
background_open := args NL                 { mb_begin(MB_BACKGROUND_DEFINE); $$ = 0; }
background_members := background_members background_member { $$ = 0; }
background_members := %empty               { $$ = 0; }
background_members := background_members NL { $$ = 0; }
